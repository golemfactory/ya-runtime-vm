+// KVM handles these MSRs and hypercalls in-kernel. Keep an explicit allowlist:
+// async page faults, migration controls and extended MSI destinations require
+// separate VMM policy/support and must not appear just because the host adds them.
+const KVM_PV_FEATURES: u32 = (1 << 0) // CLOCKSOURCE (legacy clock MSRs)
+    | (1 << 1) // NOP_IO_DELAY
+    | (1 << 3) // CLOCKSOURCE2
+    | (1 << 5) // STEAL_TIME
+    | (1 << 6) // PV_EOI
+    | (1 << 7) // PV_UNHALT (paravirtual spinlocks)
+    | (1 << 9) // PV_TLB_FLUSH
+    | (1 << 11) // PV_SEND_IPI
+    | (1 << 12) // POLL_CONTROL
+    | (1 << 13) // PV_SCHED_YIELD
+    | (1 << 24); // CLOCKSOURCE_STABLE_BIT
+
+/// Build the base guest CPU identity independently of Hyper-V enlightenments.
+fn guest_cpuid_leaf(entry: kvm::kvm_cpuid_entry2, expose_kvm: bool) -> Option<CpuidLeaf> {
+    if entry.function & 0xf0000000 == 0x40000000 {
+        if !expose_kvm {
+            return None;
+        }
+        let result = match entry.function {
+            // Advertise only the KVM leaves implemented by this policy, even if
+            // a future host kernel returns additional leaves.
+            0x4000_0000 => [0x4000_0001, entry.ebx, entry.ecx, entry.edx],
+            // Never invent host capabilities or propagate the REALTIME hint:
+            // runtime vCPUs can be preempted, particularly under nested KVM.
+            0x4000_0001 => [entry.eax & KVM_PV_FEATURES, 0, 0, 0],
+            _ => return None,
+        };
+        return Some(CpuidLeaf::new(entry.function, result));
+    }
+    let mut leaf = CpuidLeaf::new(entry.function, [entry.eax, entry.ebx, entry.ecx, entry.edx]);
+    if entry.flags & KVM_CPUID_FLAG_SIGNIFCANT_INDEX != 0 {
+        leaf = leaf.indexed(entry.index);
+    }
+    if entry.function == CpuidFunction::VersionAndFeatures.0 {
+        // KVM_GET_SUPPORTED_CPUID does not necessarily set this bit. Without it,
+        // guests can attempt bare-metal initialization of unavailable CPU MSRs.
+        leaf.result[2] |= 1 << 31;
+    }
+    Some(leaf)
