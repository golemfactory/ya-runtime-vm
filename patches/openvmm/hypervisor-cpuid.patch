+    #[test]
+    fn indirect_descriptor_rejects_nested_entry_zero_and_u16_overflow() {
+        use super::QueueCoreGetWork;
+        use super::QueueParams;
+        use crate::spec::VirtioDeviceFeatures;
+        use crate::spec::queue::DescriptorFlags;
+        use crate::spec::queue::SplitDescriptor;
+        use crate::spec::u16_le;
+        use guestmem::GuestMemory;
+
+        let mem = GuestMemory::allocate(0x20_0000);
+        let params = QueueParams {
+            size: 8,
+            enable: true,
+            desc_addr: 0x0000,
+            avail_addr: 0x1000,
+            used_addr: 0x2000,
+        };
+        let features = VirtioDeviceFeatures::new().with_ring_indirect_desc(true);
+
+        // Case 1: 0th entry inside the indirect table also sets INDIRECT.
+        let primary = SplitDescriptor {
+            address: 0x4000.into(),
+            length: 16.into(),
+            flags_raw: u16::from(DescriptorFlags::new().with_indirect(true)).into(),
+            next: 0.into(),
+        };
+        let nested = SplitDescriptor {
+            address: 0x5000.into(),
+            length: 64.into(),
+            flags_raw: u16::from(DescriptorFlags::new().with_indirect(true)).into(),
+            next: 0.into(),
+        };
+        mem.write_plain(0x0000, &primary).unwrap();
+        mem.write_plain(0x4000, &nested).unwrap();
+        mem.write_plain(0x1002, &u16_le::from(1)).unwrap();
+        mem.write_plain(0x1004, &u16_le::from(0)).unwrap();
+        let mut q = QueueCoreGetWork::new(features, mem.clone(), params, None).unwrap();
+        assert!(matches!(q.try_next_work(), Err(QueueError::DoubleIndirect)));
+
+        // Case 2: indirect table length / 16 overflows u16 (65536 descriptors = 1 MiB).
+        let oversized_primary = SplitDescriptor {
+            length: (65536 * 16).into(),
+            ..primary
+        };
+        mem.write_plain(0x0000, &oversized_primary).unwrap();
+        let mut q2 = QueueCoreGetWork::new(features, mem, params, None).unwrap();
+        assert!(matches!(q2.try_next_work(), Err(QueueError::TooLong)));
+    }
 }
