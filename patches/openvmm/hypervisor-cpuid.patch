 impl<'a> Processor<'a> {
+    /// Enforce KVM PV feature access against this vCPU's CPUID policy.
+    /// Fail closed: a host without this capability must not run an ordinary VM
+    /// while silently ignoring the caller's feature restrictions.
+    #[cfg(target_arch = "x86_64")]
+    pub fn enforce_pv_feature_cpuid(&self) -> Result<()> {
+        const NAME: &str = "KVM_CAP_ENFORCE_PV_FEATURE_CPUID";
+        let supported = self
+            .0
+            .check_extension(KVM_CAP_ENFORCE_PV_FEATURE_CPUID)
+            .map_err(|err| Error::EnableCap(NAME, err))?;
+        if supported <= 0 {
+            return Err(Error::MissingCapability(NAME));
+        }
+        // SAFETY: the ioctl targets the live vCPU fd, with the documented
+        // capability and args[0]=1. The remaining fields are zero-initialized.
+        unsafe {
+            ioctl::kvm_enable_cap(
+                self.get().vcpu.as_raw_fd(),
+                &kvm_enable_cap {
+                    cap: KVM_CAP_ENFORCE_PV_FEATURE_CPUID,
+                    args: [1, 0, 0, 0],
+                    ..Default::default()
+                },
+            )
+            .map_err(|err| Error::EnableCap(NAME, err))?;
+        }
+        Ok(())
+    }
